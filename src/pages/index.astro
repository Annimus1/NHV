---
import Layout from "../layouts/Layout.astro";
import VenezuelaMap from "../components/VenezuelaMap.astro";
---

<Layout>
  <main>
    <section
      class="container mx-auto flex min-h-[80vh] flex-col items-center justify-center gap-4 px-4 text-center"
    >
      <h1 class="mb-4 text-3xl font-bold text-heading md:text-7xl">
        Nuestra Huella por <span
          class="bg-gradient-to-r from-sky-400 to-emerald-600 bg-clip-text text-transparent"
          >Venezuela</span
        >
      </h1>
      <p class="text-lg font-normal text-body lg:text-xl">
        Un país, una gran riqueza natural, cultural y humana. Acompáñanos a
        descubrirla.
      </p>
    </section>

    <section id="mapa" class="mx-auto w-full max-w-5xl px-4 pb-20">
      <h2 class="mb-2 text-center text-2xl font-bold text-heading md:text-3xl">
        Nuestro recorrido por Venezuela
      </h2>
      <p class="mb-8 text-center text-body">
        Explora el mapa y descubre los estados que hemos visitado.
      </p>
      <VenezuelaMap />
    </section>
  </main>
</Layout>
